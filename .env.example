# Copy this file to .env and replace the dummy values. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma separated list of origins the mobile app and web tools use
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Secret used to sign access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Login tokens. These four have defaults, set them only to change the behaviour.
# Access token life in seconds (a short value such as 60 helps when testing token expiry)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Argon2id password hashing cost (memory in KiB, number of passes)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# PostgreSQL (Data Access Layer, Chuan)
DATABASE_URL=postgresql://app:change-me@localhost:5432/dating_app

# RustFS, S3 compatible photo storage (Photo Service, Tae)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=mairu-photos

# Match Engine (FastAPI, Tae)
MATCH_ENGINE_URL=http://localhost:8000
# How long to wait for the engine before answering MATCH_ENGINE_UNAVAILABLE (milliseconds)
MATCH_ENGINE_TIMEOUT_MS=5000

# Nominatim reverse geocoding (Location Service)
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional contact email for the OpenStreetMap operators (sent as the `email` parameter).
# Their usage policy asks for it when traffic grows. Leave empty to send none.
NOMINATIM_EMAIL=
