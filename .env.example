# Copy this file to .env and replace the dummy values. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma separated list of origins the mobile app and web tools use
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Secret used to sign sessions (use a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL (Data Access Layer, Chuan)
DATABASE_URL=postgresql://app:change-me@localhost:5432/dating_app

# RustFS, S3 compatible photo storage (Photo Service, Tae)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=mairu-photos

# Match Engine (FastAPI, Tae)
MATCH_ENGINE_URL=http://localhost:8000

# Nominatim reverse geocoding (Location Service)
NOMINATIM_URL=https://nominatim.openstreetmap.org
